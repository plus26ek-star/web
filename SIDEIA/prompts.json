{
  "version": 1,
  "ko": [
    {
      "date": "2026-10-03",
      "text": "은행잎은 바닥에서 더 노랗다."
    },
    {
      "date": "2026-10-04",
      "text": "창문을 열자 가을이 먼저 들어왔다."
    },
    {
      "date": "2026-10-05",
      "text": "가로등이 아직 잠에서 덜 깬 듯하다."
    },
    {
      "date": "2026-10-06",
      "text": "어릴 적 골목 냄새가 잠깐 났다."
    },
    {
      "date": "2026-10-07",
      "text": "나는 평소보다 천천히 신발을 신었다."
    },
    {
      "date": "2026-10-08",
      "text": "내가 기쁠 때 찾아가는 사람은"
    },
    {
      "date": "2026-10-09",
      "text": "살다 보니까 알게 된 건데"
    },
    {
      "date": "2026-10-10",
      "text": "나이가 들어갈수록"
    },
    {
      "date": "2026-10-11",
      "text": "빨간색 배터리로 사는 기분이다."
    },
    {
      "date": "2026-10-12",
      "text": "이상하게 자꾸 눈이 가는 것은"
    },
    {
      "date": "2026-10-13",
      "text": "아무도 모른다면 나는"
    },
    {
      "date": "2026-10-14",
      "text": "불을 끄고 혼자 남았을 때"
    },
    {
      "date": "2026-10-15",
      "text": "괜히 마음이 가벼워지는 순간은"
    },
    {
      "date": "2026-10-16",
      "text": "아침 햇빛이 오늘은 조금 차갑다."
    },
    {
      "date": "2026-10-17",
      "text": "금요일은 낙엽을 닮았다."
    },
    {
      "date": "2026-10-18",
      "text": "귤은 생각보다 둥글다."
    },
    {
      "date": "2026-10-19",
      "text": "문을 열었더니 작은 정원이 있었다."
    },
    {
      "date": "2026-10-20",
      "text": "시계가 오늘은 천천히 걷는다."
    },
    {
      "date": "2026-10-21",
      "text": "오래된 책 냄새가 다시 났다."
    },
    {
      "date": "2026-10-22",
      "text": "나는 창가에 컵 하나를 놓았다."
    },
    {
      "date": "2026-10-23",
      "text": "내가 다시 돌아간다면"
    },
    {
      "date": "2026-10-24",
      "text": "시간이 지나도 남는 것은"
    },
    {
      "date": "2026-10-25",
      "text": "요즘 나를 가장 편하게 하는 것은"
    },
    {
      "date": "2026-10-26",
      "text": "오늘의 바람은 회색에 가깝다."
    },
    {
      "date": "2026-10-27",
      "text": "목요일은 조금 길게 느껴진다."
    },
    {
      "date": "2026-10-28",
      "text": "사과 하나가 햇빛 아래 놓여 있다."
    },
    {
      "date": "2026-10-29",
      "text": "창밖에 바다가 생겨 있었다."
    },
    {
      "date": "2026-10-30",
      "text": "우산이 먼저 집에 가고 싶어 한다."
    },
    {
      "date": "2026-10-31",
      "text": "익숙한 비누 향이 스쳐갔다."
    },
    {
      "date": "2026-11-01",
      "text": "나는 주머니 속 작은 돌을 꺼냈다."
    },
    {
      "date": "2026-11-02",
      "text": "내가 가장 오래 기억하는 저녁은"
    },
    {
      "date": "2026-11-03",
      "text": "예전에는 몰랐던 것이 있다."
    },
    {
      "date": "2026-11-04",
      "text": "하루를 하나만 남긴다면"
    },
    {
      "date": "2026-11-05",
      "text": "혼자 있을 때 더 좋아지는 것은"
    },
    {
      "date": "2026-11-06",
      "text": "가끔 마음은 접힌 우산 같다."
    },
    {
      "date": "2026-11-07",
      "text": "차가운 공기가 손등을 스쳤다."
    },
    {
      "date": "2026-11-08",
      "text": "토요일은 조금 느리게 걸었다."
    },
    {
      "date": "2026-11-09",
      "text": "호두는 손바닥 안에서 작다."
    },
    {
      "date": "2026-11-10",
      "text": "현관을 나서니 낙엽이 길을 덮고 있었다."
    },
    {
      "date": "2026-11-11",
      "text": "냉장고가 밤새 무언가를 기다린 것 같다."
    },
    {
      "date": "2026-11-12",
      "text": "먼지 속에서 오래된 오후가 떠올랐다."
    },
    {
      "date": "2026-11-13",
      "text": "나는 오늘 왼쪽 길로 걸었다."
    },
    {
      "date": "2026-11-14",
      "text": "문득 고마워지는 사람이 있다."
    },
    {
      "date": "2026-11-15",
      "text": "예전과 조금 달라진 것은"
    },
    {
      "date": "2026-11-16",
      "text": "오늘 하루가 색이라면"
    },
    {
      "date": "2026-11-17",
      "text": "창가에 앉으면 생각이 조금 느려진다."
    },
    {
      "date": "2026-11-18",
      "text": "11월의 공기는 종이처럼 얇다."
    },
    {
      "date": "2026-11-19",
      "text": "화요일은 목도리를 하고 있는 것 같다."
    },
    {
      "date": "2026-11-20",
      "text": "감은 손안에서 생각보다 묵직하다."
    },
    {
      "date": "2026-11-21",
      "text": "커튼을 걷으니 작은 숲이 있었다."
    },
    {
      "date": "2026-11-22",
      "text": "의자가 빈자리를 오래 지키고 있었다."
    },
    {
      "date": "2026-11-23",
      "text": "어릴 때 맡던 겨울 냄새가 났다."
    },
    {
      "date": "2026-11-24",
      "text": "나는 책상 위의 잎을 한쪽으로 옮겼다."
    },
    {
      "date": "2026-11-25",
      "text": "내가 다시 좋아하고 싶은 것은"
    },
    {
      "date": "2026-11-26",
      "text": "살면서 의외로 오래 남은 것은"
    },
    {
      "date": "2026-11-27",
      "text": "아무도 기다리지 않는다면 나는"
    },
    {
      "date": "2026-11-28",
      "text": "요즘 내 마음은 반쯤 열린 서랍 같다."
    },
    {
      "date": "2026-11-29",
      "text": "차가운 햇살이 바닥에 내려앉았다."
    },
    {
      "date": "2026-11-30",
      "text": "금요일은 코트 주머니에 들어갔다."
    },
    {
      "date": "2026-12-01",
      "text": "도토리는 작지만 단단하다."
    },
    {
      "date": "2026-12-02",
      "text": "골목 끝에 노을이 쌓여 있었다."
    },
    {
      "date": "2026-12-03",
      "text": "우편함이 오늘은 조용히 기다린다."
    },
    {
      "date": "2026-12-04",
      "text": "낯익은 목소리가 오래전 오후를 데려왔다."
    },
    {
      "date": "2026-12-05",
      "text": "나는 따뜻한 컵을 두 손으로 감쌌다."
    },
    {
      "date": "2026-12-06",
      "text": "나이가 들수록 이상하게 좋아지는 것은"
    },
    {
      "date": "2026-12-07",
      "text": "내가 가장 편해지는 장소는"
    },
    {
      "date": "2026-12-08",
      "text": "하루 중 하나만 천천히 보낸다면"
    },
    {
      "date": "2026-12-09",
      "text": "오늘은 마음이 작은 방 같다."
    },
    {
      "date": "2026-12-10",
      "text": "첫 겨울 공기가 입술에 닿았다."
    },
    {
      "date": "2026-12-11",
      "text": "화요일은 털모자를 쓰고 있다."
    },
    {
      "date": "2026-12-12",
      "text": "귤 하나가 식탁 위에서 환하다."
    },
    {
      "date": "2026-12-13",
      "text": "문밖에 하얀 길이 이어져 있었다."
    },
    {
      "date": "2026-12-14",
      "text": "전등이 밤새 창가를 지켰다."
    },
    {
      "date": "2026-12-15",
      "text": "어릴 적 겨울 아침이 떠올랐다."
    },
    {
      "date": "2026-12-16",
      "text": "나는 장갑 한 짝을 찾아냈다."
    },
    {
      "date": "2026-12-17",
      "text": "내가 오래 간직하고 싶은 것은"
    },
    {
      "date": "2026-12-18",
      "text": "시간이 지나서야 좋아진 것은"
    },
    {
      "date": "2026-12-19",
      "text": "아무도 보지 않는다면 나는"
    },
    {
      "date": "2026-12-20",
      "text": "마음이 조용해지는 곳이 있다."
    },
    {
      "date": "2026-12-21",
      "text": "겨울 햇살이 유리처럼 반짝인다."
    },
    {
      "date": "2026-12-22",
      "text": "수요일은 주머니 속에서 잠든 것 같다."
    },
    {
      "date": "2026-12-23",
      "text": "배 하나가 식탁 위에서 노랗다."
    },
    {
      "date": "2026-12-24",
      "text": "문을 열자 눈 내리는 들판이 펼쳐졌다."
    },
    {
      "date": "2026-12-25",
      "text": "난로가 조용히 하루를 데운다."
    },
    {
      "date": "2026-12-26",
      "text": "오래된 이불 냄새가 떠올랐다."
    },
    {
      "date": "2026-12-27",
      "text": "나는 창가에서 차를 천천히 마셨다."
    },
    {
      "date": "2026-12-28",
      "text": "내가 기분이 좋아지는 작은 일은"
    },
    {
      "date": "2026-12-29",
      "text": "살다 보니 별것 아닌 것이 남았다."
    },
    {
      "date": "2026-12-30",
      "text": "나이가 들면서 덜 중요해진 것은"
    },
    {
      "date": "2026-12-31",
      "text": "오늘은 파란색 배터리로 사는 기분이다."
    },
    {
      "date": "2027-01-01",
      "text": "손끝에 겨울이 오래 남아 있다."
    },
    {
      "date": "2027-01-02",
      "text": "눈사람의 코가 한쪽으로 기울었다."
    },
    {
      "date": "2027-01-03",
      "text": "새해 인사를 먼저 하고 싶은 사람은"
    },
    {
      "date": "2027-01-04",
      "text": "새 달력을 벽에 걸었다."
    },
    {
      "date": "2027-01-05",
      "text": "오늘 하루는 새 공책의 첫 장 같다."
    },
    {
      "date": "2027-01-06",
      "text": "눈 위에 처음 보는 발자국이 있었다."
    },
    {
      "date": "2027-01-07",
      "text": "올해 조금 더 해보고 싶은 것은"
    },
    {
      "date": "2027-01-08",
      "text": "눈사람이 해 뜨는 걸 걱정하고 있다."
    },
    {
      "date": "2027-01-09",
      "text": "어릴 적 썰매를 끌던 언덕이 생각났다."
    },
    {
      "date": "2027-01-10",
      "text": "눈이 그친 새벽 골목에서"
    },
    {
      "date": "2027-01-11",
      "text": "어른이 되고 나서 알게 된 것은"
    },
    {
      "date": "2027-01-12",
      "text": "겨울에만 생각나는 음식이 있다."
    },
    {
      "date": "2027-01-13",
      "text": "1월은 아직 포장을 덜 뜯었다."
    },
    {
      "date": "2027-01-14",
      "text": "한 계절에만 살 수 있다면"
    },
    {
      "date": "2027-01-15",
      "text": "좋은 소식이 올 것 같은 날이 있다."
    },
    {
      "date": "2027-01-16",
      "text": "한 해가 바뀌어도 그대로인 것은"
    },
    {
      "date": "2027-01-17",
      "text": "눈 밟는 소리가 생각보다 크다."
    },
    {
      "date": "2027-01-18",
      "text": "정류장 의자가 반쯤 젖어 있다."
    },
    {
      "date": "2027-01-19",
      "text": "같이 있으면 시간이 빨리 가는 사람이 있다."
    },
    {
      "date": "2027-01-20",
      "text": "장갑을 벗고 눈을 만져 보았다."
    },
    {
      "date": "2027-01-21",
      "text": "이번 주는 다 녹지 않은 눈 같다."
    },
    {
      "date": "2027-01-22",
      "text": "엘리베이터에 없던 층 버튼이 생겼다."
    },
    {
      "date": "2027-01-23",
      "text": "내가 자꾸 미루게 되는 것은"
    },
    {
      "date": "2027-01-24",
      "text": "난로가 오늘은 조금 수다스럽다."
    },
    {
      "date": "2027-01-25",
      "text": "처음 받은 용돈으로 산 것이 생각난다."
    },
    {
      "date": "2027-01-26",
      "text": "밤늦게 불 켜진 창문 하나를 보았다."
    },
    {
      "date": "2027-01-27",
      "text": "생각보다 내가 좋아하는 것이 많았다."
    },
    {
      "date": "2027-01-28",
      "text": "나는 눈 오는 조용한 밤이 좋다."
    },
    {
      "date": "2027-01-29",
      "text": "오늘은 시간이 눈처럼 쌓인다."
    },
    {
      "date": "2027-01-30",
      "text": "지금 가진 것 중 하나를 바꾼다면"
    },
    {
      "date": "2027-01-31",
      "text": "이유 없이 마음이 따뜻해진 순간은"
    },
    {
      "date": "2027-02-01",
      "text": "작년 이맘때의 나는"
    },
    {
      "date": "2027-02-02",
      "text": "따뜻한 국물 냄새가 복도까지 왔다."
    },
    {
      "date": "2027-02-03",
      "text": "귤껍질이 책상 위에 꽃처럼 펼쳐져 있다."
    },
    {
      "date": "2027-02-04",
      "text": "처음 만났을 때와 달라진 사람이 있다."
    },
    {
      "date": "2027-02-05",
      "text": "오늘은 엘리베이터 대신 계단으로 올라갔다."
    },
    {
      "date": "2027-02-06",
      "text": "요즘 나는 예열 중인 오븐 같다."
    },
    {
      "date": "2027-02-07",
      "text": "우체통에서 내일 날짜의 편지가 나왔다."
    },
    {
      "date": "2027-02-08",
      "text": "아무 계획 없는 하루가 생긴다면"
    },
    {
      "date": "2027-02-09",
      "text": "겨울 코트가 옷걸이에서 기지개를 켰다."
    },
    {
      "date": "2027-02-10",
      "text": "설날 아침의 부엌 소리가 떠올랐다."
    },
    {
      "date": "2027-02-11",
      "text": "기차가 떠난 뒤의 플랫폼에서"
    },
    {
      "date": "2027-02-12",
      "text": "사정을 알고 나니 다르게 보였다."
    },
    {
      "date": "2027-02-13",
      "text": "이상하게 끌리는 색깔은"
    },
    {
      "date": "2027-02-14",
      "text": "2월은 생각보다 짧게 웃는다."
    },
    {
      "date": "2027-02-15",
      "text": "시간을 한 시간만 멈출 수 있다면"
    },
    {
      "date": "2027-02-16",
      "text": "조금 쓸쓸했지만 싫지 않았다."
    },
    {
      "date": "2027-02-17",
      "text": "어릴 때보다 좋아진 것은"
    },
    {
      "date": "2027-02-18",
      "text": "창문에 김이 하얗게 서렸다."
    },
    {
      "date": "2027-02-19",
      "text": "고드름이 처마 끝에서 자라고 있다."
    },
    {
      "date": "2027-02-20",
      "text": "요즘 자주 생각나는 사람은"
    },
    {
      "date": "2027-02-21",
      "text": "서랍 깊숙한 곳에서 편지를 꺼냈다."
    },
    {
      "date": "2027-02-22",
      "text": "오늘 내 마음은 김 서린 유리창 같다."
    },
    {
      "date": "2027-02-23",
      "text": "책장을 넘기자 바람이 불어왔다."
    },
    {
      "date": "2027-02-24",
      "text": "요즘 나를 웃게 하는 것은"
    },
    {
      "date": "2027-02-25",
      "text": "주전자가 휘파람으로 나를 불렀다."
    },
    {
      "date": "2027-02-26",
      "text": "졸업식 날의 꽃다발 냄새가 났다."
    },
    {
      "date": "2027-02-27",
      "text": "따뜻한 이불 속에서 바람 소리를 들었다."
    },
    {
      "date": "2027-02-28",
      "text": "그때는 그게 최선이었다."
    },
    {
      "date": "2027-03-01",
      "text": "몇 번을 들어도 좋은 노래가 있다."
    },
    {
      "date": "2027-03-02",
      "text": "일요일 오후는 조금 말랑하다."
    },
    {
      "date": "2027-03-03",
      "text": "하루 동안 말을 하지 않는다면"
    },
    {
      "date": "2027-03-04",
      "text": "긴장이 스르르 풀리는 순간은"
    },
    {
